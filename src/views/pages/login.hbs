<div class="auth-card card mx-auto">
  <div class="card-body p-4 p-md-5">
    <h1 class="h3 fw-bold text-center mb-1">Вход</h1>
    <p class="text-center text-body-secondary mb-4">Рады видеть вас снова.</p>

    {{#if error}}<div class="alert alert-danger" role="alert">{{error}}</div>{{/if}}

    <form method="post" action="/login">
      {{#if next}}<input type="hidden" name="next" value="{{next}}">{{/if}}
      <div class="mb-3">
        <label for="login" class="form-label">Имя пользователя или почта</label>
        <input type="text" class="form-control" id="login" name="login" value="{{values.login}}" required
               autocomplete="username" autocapitalize="none" spellcheck="false" autofocus>
      </div>
      <div class="mb-4">
        <label for="password" class="form-label">Пароль</label>
        <input type="password" class="form-control" id="password" name="password" required autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn-primary w-100 py-2">Войти</button>
    </form>

    <p class="text-center mt-4 mb-0">Нет аккаунта? <a href="/register">Зарегистрируйтесь</a></p>
  </div>
</div>
