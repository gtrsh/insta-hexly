{{#if pagination.hasPages}}
<nav class="mt-4" aria-label="Страницы">
  <ul class="pagination justify-content-center flex-wrap">
    <li class="page-item {{#unless pagination.prev}}disabled{{/unless}}">
      {{#if pagination.prev}}
        <a class="page-link" href="{{pagination.prev}}" aria-label="Предыдущая"><i class="bi bi-chevron-left"></i></a>
      {{else}}
        <span class="page-link"><i class="bi bi-chevron-left"></i></span>
      {{/if}}
    </li>
    {{#each pagination.items}}
      {{#if ellipsis}}
        <li class="page-item disabled"><span class="page-link">…</span></li>
      {{else}}
        <li class="page-item {{#if active}}active{{/if}}" {{#if active}}aria-current="page"{{/if}}>
          <a class="page-link" href="{{href}}">{{number}}</a>
        </li>
      {{/if}}
    {{/each}}
    <li class="page-item {{#unless pagination.next}}disabled{{/unless}}">
      {{#if pagination.next}}
        <a class="page-link" href="{{pagination.next}}" aria-label="Следующая"><i class="bi bi-chevron-right"></i></a>
      {{else}}
        <span class="page-link"><i class="bi bi-chevron-right"></i></span>
      {{/if}}
    </li>
  </ul>
</nav>
{{/if}}
